# Runtime mode
MODE=development

# Backend (not published: reached only through nginx)
DB_HOST=db
DB_PORT=5432
# Required: a long random string, e.g. the output of `openssl rand -hex 32`
JWT_SECRET=

# nginx (HTTPS, needed for the microphone and for playing from other computers).
# Must be above 1024: rootless Docker, like on the school computers, cannot use 80/443.
HTTPS_PORT=8443
HTTP_PORT=8000
# Leave empty: the website uses its own address and nginx / the Vite proxy forward /api and /ws.
VITE_API_URL=

# Database
POSTGRES_USER=transcendence
# Required: choose your own password
POSTGRES_PASSWORD=
POSTGRES_DB=transcendence


# Voice chat: players must have a connected microphone to ready up. Set to false to test without
# microphones (e.g. running the game from the Godot editor).
VOICE_REQUIRED=true
# Optional STUN servers (comma separated) so players on different networks can connect their voice,
# e.g. stun:stun.example.org:3478. Not needed on the same machine or network.
VITE_STUN_URLS=
