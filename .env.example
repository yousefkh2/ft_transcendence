# Runtime mode
MODE=development

# Backend
BACKEND_PORT=8080
DB_HOST=db
DB_PORT=5432
OPENAI_API_KEY=
JWT_SECRET=change_me_in_production

# Frontend
FRONTEND_PORT=5173
# Leave empty: the website uses its own address and nginx / the Vite proxy forward /api and /ws.
VITE_API_URL=

# Database
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=transcendence_dev_password
POSTGRES_DB=transcendence
POSTGRES_PORT=5433


# Voice chat: players must have a connected microphone to ready up. Set to false to test without
# microphones (e.g. running the game from the Godot editor).
VOICE_REQUIRED=true
# Optional STUN servers (comma separated) so players on different networks can connect their voice,
# e.g. stun:stun.example.org:3478. Not needed on the same machine or network.
VITE_STUN_URLS=
